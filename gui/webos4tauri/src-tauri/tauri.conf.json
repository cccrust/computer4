{
  "productName": "webOS",
  "version": "0.1.0",
  "identifier": "com.webos.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "webOS",
        "width": 430,
        "height": 932,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 375,
        "minHeight": 667
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
